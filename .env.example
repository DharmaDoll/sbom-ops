SBOM_OPS_DT_BASE_URL=https://dependency-track.example.com
SBOM_OPS_DT_API_KEY=replace-me
SBOM_OPS_SBOM_UPLOAD_API_KEY=replace-me
SBOM_OPS_DT_PROJECT_UUID=replace-me
SBOM_OPS_DT_PROJECT_NAME=sbom-ops-vulnerable-demo
SBOM_OPS_DT_PROJECT_VERSION=0.1.0
# SBOM_OPS_GITHUB_TOKEN=replace-me
# Alternatively export GH_TOKEN="$(gh auth token)" for local operation.
SBOM_OPS_GITHUB_OWNER=example-org
SBOM_OPS_GITHUB_REPO=example-repo
SBOM_OPS_PRIORITY_P1_EPSS_THRESHOLD=0.7
SBOM_OPS_PRIORITY_P2_CVSS_THRESHOLD=7.0
SBOM_OPS_ISSUE_LABEL_PREFIX=sbom
SBOM_OPS_LOG_LEVEL=INFO
SBOM_OPS_DRY_RUN=false
SBOM_OPS_DT_PAGE_SIZE=100
SBOM_OPS_DT_TIMEOUT_SECONDS=30
SBOM_OPS_DT_MAX_RETRIES=3
SBOM_OPS_DT_RETRY_BACKOFF_SECONDS=1
SBOM_OPS_DT_ANALYSIS_WAIT_TIMEOUT_SECONDS=120
SBOM_OPS_DT_ANALYSIS_POLL_INTERVAL_SECONDS=5
SBOM_OPS_WAIT_FOR_ANALYSIS=false
# Automatic closure is opt-in and requires --wait-for-analysis by default.
SBOM_OPS_CLOSE_MISSING_FINDINGS=false
SBOM_OPS_MISSING_CONFIRMATION_RUNS=2
SBOM_OPS_GITHUB_TIMEOUT_SECONDS=30
SBOM_OPS_GITHUB_MAX_RETRIES=3
SBOM_OPS_GITHUB_RETRY_BACKOFF_SECONDS=1
SBOM_OPS_INTEL_TIMEOUT_SECONDS=30
SBOM_OPS_INTEL_MAX_RETRIES=3
SBOM_OPS_INTEL_RETRY_BACKOFF_SECONDS=1
